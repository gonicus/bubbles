@@ -1499,6 +1499,46 @@ pub struct SmbiosOptions {
     /// Additional OEM strings to add to SMBIOS table.
     #[serde(default)]
     pub oem_strings: Vec<String>,
+
+    /// File to read further OEM strings from, one per line. Keeps them off the
+    /// command line, which other processes can read.
+    pub oem_strings_file: Option<PathBuf>,
+}
+
+impl SmbiosOptions {
+    /// Appends the strings in `oem_strings_file` to `oem_strings` and clears the option. Done
+    /// while the command line is converted, so that a bad file fails with the other argument
+    /// errors instead of in `setup_smbios`.
+    pub fn read_oem_strings_file(&mut self) -> std::result::Result<(), String> {
+        use std::io::Read;
+        use std::io::Seek;
+
+        let Some(path) = self.oem_strings_file.take() else {
+            return Ok(());
+        };
+        let error = |e: &dyn std::fmt::Display| {
+            format!("failed to read oem-strings-file {}: {e}", path.display())
+        };
+        let mut file =
+            base::open_file_or_duplicate(&path, std::fs::OpenOptions::new().read(true))
+                .map_err(|e| error(&e))?;
+        // A /proc/self/fd/N is duplicated, not reopened, so it shares its offset with the
+        // writer, which likely left it at the end.
+        let mut content = String::new();
+        file.rewind()
+            .and_then(|()| file.read_to_string(&mut content))
+            .map_err(|e| error(&e))?;
+        if content.contains('\0') {
+            return Err(error(&"contains a null character"));
+        }
+        self.oem_strings.extend(
+            content
+                .lines()
+                .filter(|line| !line.is_empty())
+                .map(str::to_string),
+        );
+        Ok(())
+    }
 }
 
